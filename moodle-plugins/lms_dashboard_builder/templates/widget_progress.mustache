{{!
    @template local_lms_dashboard_builder/widget_progress

    Progress Bar and completion tracking widget.

    Context variables:
    * widgetid - Unique widget ID.
    * title - Progress title.
}}
<div class="card h-100 shadow-sm border-0 bg-white widget-container widget-progress" id="widget-{{widgetid}}" data-widgetid="{{widgetid}}">
    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
        <h6 class="card-title fw-bold text-dark mb-0">{{title}}</h6>
    </div>
    <div class="card-body p-4 d-flex flex-column justify-content-center">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small" id="progress-label-{{widgetid}}">Completion Rate</span>
            <span class="fw-bold text-primary fs-5" id="progress-percentage-{{widgetid}}">0%</span>
        </div>
        <div class="progress" style="height: 12px; border-radius: 6px;">
            <div class="progress-bar bg-primary"
                 id="progress-bar-{{widgetid}}"
                 role="progressbar"
                 style="width: 0%;"
                 aria-valuenow="0"
                 aria-valuemin="0"
                 aria-valuemax="100"></div>
        </div>
        <div class="d-flex justify-content-between text-muted small mt-2" id="progress-detail-{{widgetid}}">
            <span>Completed: 0</span>
            <span>Total: 0</span>
        </div>
    </div>
</div>
