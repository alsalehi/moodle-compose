{{!
    @template local_lms_dashboard_builder/dashboard_view

    Full Dashboard View template.

    Context variables:
    * instanceid - Unique placement instance ID (optional, falls back to dashboardid).
    * dashboardid - Unique dashboard ID.
    * dashboardname - Dashboard name.
    * hasfilters - Whether filters are enabled.
    * widgets - Array of widget layout specifications.
}}
<div class="local-lms-dashboard-root {{cssclass}}"
     id="lms-dashboard-{{#instanceid}}{{instanceid}}{{/instanceid}}{{^instanceid}}{{dashboardid}}{{/instanceid}}"
     data-instanceid="{{#instanceid}}{{instanceid}}{{/instanceid}}{{^instanceid}}{{dashboardid}}{{/instanceid}}"
     data-dashboardid="{{dashboardid}}">
    {{#hastabs}}
    <ul class="nav nav-pills dashboard-tabs mb-3 gap-1">
        {{#tabs}}
        <li class="nav-item">
            <a class="nav-link py-1 px-3 {{#isactive}}active fw-semibold{{/isactive}}{{^isactive}}text-muted{{/isactive}}" href="{{url}}">
                {{name}}
            </a>
        </li>
        {{/tabs}}
    </ul>
    {{/hastabs}}

    {{#hasfilters}}
        {{> local_lms_dashboard_builder/filter_bar }}
    {{/hasfilters}}

    <div class="row g-3 dashboard-grid">
        {{#widgets}}
        <div class="col-12 col-md-{{grid_width}} widget-slot {{cssclass}}" data-widgetid="{{id}}" data-widgettype="{{widgettype}}">
            <div class="card h-100 shadow-sm border-0 bg-white widget-placeholder widget-container-target" data-widgetid="{{id}}">
                <div class="card-body p-4 d-flex justify-content-center align-items-center">
                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status">
                        <span class="visually-hidden">{{#str}} loading_widget, local_lms_dashboard_builder {{/str}}</span>
                    </div>
                    <span class="text-muted small">{{title}}</span>
                </div>
            </div>
        </div>
        {{/widgets}}
    </div>
</div>
