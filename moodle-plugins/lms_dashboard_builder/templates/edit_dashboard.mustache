</div>

<datalist id="kpi-metric-datalist"></datalist>

{{#js}}
(function() {
    // 1. Cascading Global Filter Builder fields.
    var filterTypeSel = document.getElementById('filtertype-select');
    function updateFilterCascade() {
        if (!filterTypeSel) return;
        var val = filterTypeSel.value;
        var contextSec = document.getElementById('filter-cfg-context');
        var userSec = document.getElementById('filter-cfg-user');
        var reqParamSec = document.getElementById('filter-cfg-request-param');
        var reqVisSec = document.getElementById('filter-cfg-request-vis');
        var customKeySec = document.getElementById('filter-cfg-custom-key');
        var customOptSec = document.getElementById('filter-cfg-custom-options');
        var defValSec = document.getElementById('filter-defaultvalue-wrapper');

        if (contextSec) contextSec.classList.add('d-none');
        if (userSec) userSec.classList.add('d-none');
        if (reqParamSec) reqParamSec.classList.add('d-none');
        if (reqVisSec) reqVisSec.classList.add('d-none');
        if (customKeySec) customKeySec.classList.add('d-none');
        if (customOptSec) customOptSec.classList.add('d-none');
        if (defValSec) defValSec.classList.remove('d-none');

        if (val === 'from_context') {
            if (contextSec) contextSec.classList.remove('d-none');
            if (defValSec) defValSec.classList.add('d-none');
        } else if (val === 'from_user') {
            if (userSec) userSec.classList.remove('d-none');
            if (defValSec) defValSec.classList.add('d-none');
        } else if (val === 'from_request') {
            if (reqParamSec) reqParamSec.classList.remove('d-none');
            if (reqVisSec) reqVisSec.classList.remove('d-none');
        } else if (val === 'custom') {
            if (customKeySec) customKeySec.classList.remove('d-none');
            if (customOptSec) customOptSec.classList.remove('d-none');
        }
    }
    if (filterTypeSel) {
        filterTypeSel.addEventListener('change', updateFilterCascade);
        updateFilterCascade();
    }

    // 2. Cascading Query Provider -> KPI Metric Datalist.
    var metricCatalog = {{{providermetricscatalogjson}}};
    var querySelect = document.querySelector('select[name="queryid"]');
    var metricInput = document.querySelector('input[name="metric"]');
    var datalist = document.getElementById('kpi-metric-datalist');

    function updateMetricDatalist() {
        if (!querySelect || !datalist) return;
        var qid = querySelect.value;
        datalist.innerHTML = '';
        if (metricCatalog && metricCatalog[qid]) {
            var metrics = metricCatalog[qid];
            Object.keys(metrics).forEach(function(k) {
                var opt = document.createElement('option');
                opt.value = k;
                opt.label = metrics[k];
                datalist.appendChild(opt);
            });
            if (metricInput) {
                metricInput.setAttribute('list', 'kpi-metric-datalist');
            }
        }
    }
    if (querySelect) {
        querySelect.addEventListener('change', updateMetricDatalist);
        updateMetricDatalist();
    }

    // 3. Cascading Public Visitor toggle -> restrict to KPI only.
    var publicRoleChk = document.querySelector('input.role-filter-chk[data-ispublic="1"]');
    var widgetTypeSel = document.querySelector('select[name="widgettype"]');
    function checkPublicVisitorMode() {
        if (!publicRoleChk || !widgetTypeSel) return;
        var isPublic = publicRoleChk.checked;
        for (var i = 0; i < widgetTypeSel.options.length; i++) {
            var opt = widgetTypeSel.options[i];
            if (isPublic && opt.value !== 'kpi') {
                opt.disabled = true;
            } else {
                opt.disabled = false;
            }
        }
        if (isPublic && widgetTypeSel.value !== 'kpi') {
            widgetTypeSel.value = 'kpi';
        }
    }
    if (publicRoleChk) {
        publicRoleChk.addEventListener('change', checkPublicVisitorMode);
        checkPublicVisitorMode();
    }
})();
{{/js}}
