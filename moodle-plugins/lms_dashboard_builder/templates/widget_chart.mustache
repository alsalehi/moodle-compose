{{!
    @template local_lms_dashboard_builder/widget_chart

    Customizable Chart widget with accessible fallback.

    Context variables:
    * widgetid - Unique widget ID.
    * title - Chart title.
    * charttype - Type of chart (bar, line, pie, doughnut).
}}
<div class="card h-100 shadow-sm border-0 bg-white widget-container widget-chart" id="widget-{{widgetid}}" data-widgetid="{{widgetid}}">
    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0 d-flex justify-content-between align-items-center">
        <h6 class="card-title fw-bold text-dark mb-0">{{title}}</h6>
    </div>
    <div class="card-body p-4 position-relative">
        <div class="chart-canvas-container" style="min-height: 220px; position: relative;">
            <canvas id="chart-canvas-{{widgetid}}" aria-label="{{title}}" role="img"></canvas>
        </div>
        <div class="chart-accessible-summary visually-hidden" id="chart-accessible-{{widgetid}}">
            <span class="sr-only">Accessible data for {{title}} will be loaded dynamically.</span>
        </div>
    </div>
</div>
