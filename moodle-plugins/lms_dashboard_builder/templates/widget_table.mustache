{{!
    @template local_lms_dashboard_builder/widget_table

    Data Table widget.

    Context variables:
    * widgetid - Unique widget ID.
    * title - Table title.
}}
<div class="card h-100 shadow-sm border-0 bg-white widget-container widget-table" id="widget-{{widgetid}}" data-widgetid="{{widgetid}}">
    <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
        <h6 class="card-title fw-bold text-dark mb-0">{{title}}</h6>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="table-element-{{widgetid}}">
                <thead class="table-light">
                    <tr id="table-head-{{widgetid}}">
                        <th scope="col">Loading...</th>
                    </tr>
                </thead>
                <tbody id="table-body-{{widgetid}}">
                    <tr>
                        <td class="text-muted text-center py-3">Loading query data...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
