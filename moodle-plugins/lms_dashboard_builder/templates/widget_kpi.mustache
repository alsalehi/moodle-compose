{{!
    @template local_lms_dashboard_builder/widget_kpi

    KPI Metric Card widget.

    Context variables:
    * widgetid - Unique identifier.
    * title - Widget title.
    * value - Metric value.
    * subtitle - Context label.
    * trend - Optional trend text.
}}
<div class="card h-100 shadow-sm border-0 bg-white widget-container widget-kpi" id="widget-{{widgetid}}" data-widgetid="{{widgetid}}">
    <div class="card-body d-flex flex-column justify-content-between p-4">
        <div>
            <h6 class="card-subtitle text-muted text-uppercase fw-semibold mb-2 fs-7 tracking-wide">{{title}}</h6>
            <div class="display-6 fw-bold text-dark kpi-value mb-1" id="kpi-value-{{widgetid}}">{{value}}</div>
        </div>
        {{#subtitle}}
        <div class="small text-secondary mt-2">{{subtitle}}</div>
        {{/subtitle}}
    </div>
</div>
