# Replace every value with the actual current value from Dokploy / docker inspect.
# Do not commit a real .env file or real credentials to GitHub.
MARIADB_ROOT_PASSWORD=REPLACE_WITH_CURRENT_ROOT_PASSWORD
MARIADB_USER=REPLACE_WITH_CURRENT_MOODLE_DB_USER
MARIADB_PASSWORD=REPLACE_WITH_CURRENT_MOODLE_DB_PASSWORD
MARIADB_DATABASE=REPLACE_WITH_CURRENT_MOODLE_DATABASE

# These must be exact Docker volume names from `docker inspect`.
MARIADB_DATA_VOLUME_NAME=REPLACE_WITH_EXISTING_MARIADB_VOLUME
MOODLE_DATA_VOLUME_NAME=REPLACE_WITH_EXISTING_MOODLEDATA_VOLUME
MOODLE_CURRENT_CODE_VOLUME_NAME=REPLACE_WITH_EXISTING_MOODLE_HTML_VOLUME

# New persistent volumes. Keep these names unchanged on future deployments.
MOODLE_CONFIG_VOLUME_NAME=techhub_moodle_config
REDIS_DATA_VOLUME_NAME=techhub_redis_data
